# CASA School environment template
# Copy required values into .env.local. Never put real secrets here.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a unique 32+ byte secret for each deployed environment.
AUTH_SECURITY_HMAC_SECRET=replace-with-a-long-random-secret

# Optional trusted-proxy configuration. Leave disabled unless the
# deployment edge is explicitly configured to sanitize this header.
CASA_TRUST_PROXY_HEADERS=false
CASA_PROXY_IP_HEADER=x-forwarded-for
